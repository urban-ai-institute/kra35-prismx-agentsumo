# AgentSUMO environment configuration
# Copy this file to `.env` and fill in your own credentials:
#   cp .env.example .env

# === Required ===

# Anthropic Claude API key.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Mapbox access token (used by the web interface for basemap rendering).
# Get one at: https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# Absolute path to your local SUMO installation (must contain bin/sumo).
# On macOS (official SUMO installer):
#   /Library/Frameworks/EclipseSUMO.framework/Versions/<version>/EclipseSUMO
# On macOS (Homebrew, brew tap dlr-ts/sumo): $(brew --prefix sumo)/share/sumo
#   /opt/homebrew/opt/sumo/share/sumo
# On Linux (apt install sumo sumo-tools):
#   /usr/share/sumo
# On Windows:
#   C:\Program Files (x86)\Eclipse\Sumo
SUMO_HOME=

# === Optional ===

# Override the base directory for AgentSUMO MCP server outputs (networks,
# trips, simulations, etc.). Defaults to the current working directory, or
# ~/agentsumo-output when that directory is not writable.
# AGENTSUMO_MCP_OUTPUT_BASE=
